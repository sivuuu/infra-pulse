# InfraPulse Environment Configuration Template
# Copy to .env and adjust variables as needed

# Django Backend Configuration
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local development)
# DATABASE_URL=postgres://infrapulse_user:infrapulse_password@localhost:5432/infrapulse_db

# Runtime Adapter Selection ('podman' or 'docker' or 'mock')
RUNTIME_ADAPTER=podman

# Collector Settings
COLLECTOR_POLL_INTERVAL_SECONDS=5
COLLECTOR_METRIC_RETENTION_HOURS=24
LOG_RETENTION_DAYS=7

# Default Administrator Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator123
